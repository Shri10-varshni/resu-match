{
  "id": null,
  "uid": "resumatch-overview",
  "title": "ResuMatch Overview",
  "tags": ["resumatch"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "HTTP requests per second",
      "gridPos": {"h": 9, "w": 12, "x": 0, "y": 0},
      "targets": [
        {
          "expr": "sum by (uri, status) (rate(http_server_requests_seconds_count{application=\"resumatch\"}[5m]))",
          "legendFormat": "{{uri}} {{status}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "JVM heap used",
      "gridPos": {"h": 9, "w": 12, "x": 12, "y": 0},
      "targets": [
        {
          "expr": "jvm_memory_used_bytes{application=\"resumatch\", area=\"heap\"}",
          "legendFormat": "{{id}}",
          "refId": "A"
        }
      ]
    }
  ]
}
